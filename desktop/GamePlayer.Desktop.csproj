<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>0.3.7</Version><OutputType>WinExe</OutputType><TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <Nullable>disable</Nullable><ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>GamePlayer.Desktop</AssemblyName><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <Compile Include="*.cs" />
    <Compile Include="../src/overlay-window.cs" Link="KeyboardWindow.cs" />
    <Content Include="web/**/*;profiles/*.json;../src/overlay-layout.json;../src/key-map.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

